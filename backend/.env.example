PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/workshop-app
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:5173
# First start only: existing users and workshops are moved into this default institute.
DEFAULT_INSTITUTE_NAME=INTechGenius
# Admin code for the default institute (keeps your current admin code working)
ADMIN_INVITE_CODE=change_this_to_a_private_code
# Student code for the default institute (random one is generated if empty)
DEFAULT_STUDENT_CODE=

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
