# Dependencies
node_modules/

# Local environment files (secrets). Templates named .env.example stay tracked.
.env
.env.*
*.env
!.env.example

# Build output
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local tooling settings
.claude/

# User uploads (the folder itself is kept with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
